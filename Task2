#include<stdio.h>
int main() {
	int late;
	printf("Enter the number of days late: ");
	scanf("%d",&late);
	if(late>=0){
		if (late==0){
			printf("No fine");
		}else{
			if(late>=1 && late<=5){
				printf("Fine: Rs 50/-");
			}else{
				if(late>=6 && late<=10){
					printf("Fine:Rs 100/-");
				}else{
					printf("Fine:Rs 200/-");
				}
			}
		}
	}else{
		printf("INVALID DATA ENTRY");
	}
}
